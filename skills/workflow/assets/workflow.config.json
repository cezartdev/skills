{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.0",
  "pipeline": {
    "default_interval_minutes": 30,
    "max_iterations": null,
    "stages": [
      { "id": "fix", "role": "Fix-Worker Specialist", "description": "Bug stabilization and 100% green test pass" },
      { "id": "refactor", "role": "Refactor-Worker Specialist", "description": "Clean code, modularity, and complexity reduction" },
      { "id": "doc", "role": "Doc-Worker Specialist", "description": "Docstrings, OpenAPI schemas, and spec sync" },
      { "id": "curator", "role": "Curator Specialist", "description": "Quality gate, ADR generation, and PR synthesis" }
    ],
    "auto_merge": {
      "enabled": false,
      "strategy": "no-ff",
      "require_all_tests_pass": true,
      "require_security_scan": true
    },
    "adrs": {
      "enabled": true,
      "format": "MADR",
      "directory": ".workflow/specs/{spec}/adrs"
    }
  },
  "test_runner": {
    "command": "{{TEST_COMMAND}}",
    "args": ["--run"],
    "coverage_threshold": 80
  },
  "drift_detection": {
    "enabled": true,
    "auto_reexplore": true,
    "manifest_files": ["package.json", "pyproject.toml", "Cargo.toml", "go.mod", "pom.xml", "build.gradle"]
  },
  "memory": {
    "directory": ".workflow/memory",
    "max_episodic_files_per_archetype": 10,
    "auto_compact_on_threshold": true,
    "require_memory_before_run": true
  },
  "prs": {
    "directory": ".workflow/prs"
  },
  "worktrees": {
    "directory": ".workflow/worktrees",
    "auto_clean_on_merge": true
  },
  "quality_gate": {
    "require_user_confirmation": true,
    "strict_acceptance_criteria": true,
    "suggest_edge_cases": true
  }
}
